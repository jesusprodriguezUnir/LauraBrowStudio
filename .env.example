# ─────────────────────────────────────────────────────────────
# LauraBrowStudio — datos del negocio
# Copia este archivo a `.env` y sustituye los valores pendientes.
# Reglas: los valores van SIN espacios, los teléfonos en formato
# internacional sin el prefijo "+" (p. ej. 34600123456).
# ─────────────────────────────────────────────────────────────

# WhatsApp / teléfono en formato internacional, p. ej. 34600123456
PUBLIC_WHATSAPP_NUMBER=

# Teléfono en formato de visualización, p. ej. 600 123 456
PUBLIC_PHONE_DISPLAY=

# Email de negocio
PUBLIC_EMAIL=

# Dirección completa del estudio, p. ej. Calle Mayor 14, 34001 Palencia
PUBLIC_ADDRESS=

# Código postal (si la dirección arriba no lo incluye). Schema.org lo usa.
PUBLIC_POSTAL_CODE=

# Usuario de Instagram (sin @)
PUBLIC_INSTAGRAM=

# NIF y nombre fiscal del titular
PUBLIC_NIF=
PUBLIC_LEGAL_NAME=

# Coordenadas para Google Maps / schema.org (p. ej. 42.0087, -4.5288)
PUBLIC_LAT=
PUBLIC_LNG=

# Horario de atención, p. ej. "09:00-14:00,16:00-20:00" (MarxDB dd:mm)
PUBLIC_BUSINESS_HOURS=

# URL pública del sitio (con https)
PUBLIC_SITE_URL=https://laurabrowstudio.es

# Endpoint del formulario (Formspree, Web3Forms o similar).
# Si se deja vacío, el formulario abre WhatsApp con los datos preescritos.
PUBLIC_FORM_ENDPOINT=

# Sitekey de Cloudflare Turnstile (opcional). Sin ella, el envío por
# formulario no muestra captcha (modo dev).
PUBLIC_TURNSTILE_SITE_KEY=

# Analytic cookieless (Plausible). Domain del sitio en la cuenta.
# Vacío = analítica desactivada.
PUBLIC_PLAUSIBLE_DOMAIN=