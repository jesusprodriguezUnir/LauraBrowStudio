---
import "../styles.css";
import { ClientRouter } from "astro:transitions";

import "@fontsource/poppins/latin-300.css";
import "@fontsource/poppins/latin-300-italic.css";
import "@fontsource/poppins/latin-400.css";
import "@fontsource/poppins/latin-400-italic.css";
import "@fontsource/poppins/latin-500.css";
import "@fontsource/poppins/latin-600.css";
import "@fontsource/poppins/latin-700.css";
import "@fontsource/cormorant-garamond/latin-300.css";
import "@fontsource/cormorant-garamond/latin-400.css";
import "@fontsource/cormorant-garamond/latin-400-italic.css";
import "@fontsource/cormorant-garamond/latin-500.css";

import { site } from "../lib/site-config";
import { faqItems } from "../lib/faq";
import { Toaster } from "sonner";

interface Props {
  title: string;
  description: string;
  /** Ruta para el canonical; por defecto "/" */
  path?: string;
  /** URL absoluta de la imagen OG; por defecto icono de la marca */
  image?: string;
  /** Incluir el FAQPage JSON-LD (visible en la home) */
  includeFaq?: boolean;
  /** Excluir la página del índice (404 y similares) */
  noindex?: boolean;
}

const { title, description, path = "/", image, includeFaq = false, noindex = false } = Astro.props;

const canonical = new URL(path, site.url).toString();
const ogImage = image ? new URL(image, site.url).toString() : new URL("/og-image.jpg", site.url).toString();

const addressSchema = site.address.startsWith("[") ? undefined : {
  "@type": "PostalAddress",
  streetAddress: site.address,
  addressLocality: site.city,
  addressRegion: site.region,
  postalCode: site.postalCode || undefined,
  addressCountry: "ES",
};

const beautySalonSchema = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  name: site.name,
  description: site.claim,
  image: ogImage,
  url: canonical,
  telephone: site.phoneDisplay.startsWith("[") ? undefined : site.phoneDisplay,
  email: site.email.startsWith("[") ? undefined : site.email,
  address: addressSchema,
  geo: site.geo.lat && site.geo.lng
    ? { "@type": "GeoCoordinates", latitude: site.geo.lat, longitude: site.geo.lng }
    : undefined,
  openingHours: site.businessHours,
  priceRange: "€€",
  areaServed: site.city,
  sameAs: site.instagram.startsWith("[") ? undefined : `https://www.instagram.com/${site.instagram}`,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Microblading de cejas",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: "Microblading pelo a pelo", description: "Microblading de cejas en Palencia: pigmentación manual trazo a trazo, diseñada sobre el rostro." },
      },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const breadcrumbSchema = path !== "/"
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: site.name, item: site.url },
        { "@type": "ListItem", position: 2, name: title },
      ],
    }
  : undefined;

import WhatsappFloating from "../components/site/WhatsappFloating.astro";
import { SiteHeader } from "../components/site/site-header";
import SiteFooter from "../components/site/SiteFooter.astro";
import WhatsappBar from "../components/site/WhatsappBar.astro";
---

<!doctype html>
<html lang="es" data-transition-root>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3ede2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#201b1a" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.name} — ${site.claim}`} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Tema nocturno sin FOUC -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("lbs-theme");
          var dark = t === "dark";
          if (dark) document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-foreground focus:px-5 focus:py-2 focus:text-[0.75rem] focus:uppercase focus:tracking-[0.14em] focus:text-background"
    >
      Saltar al contenido
    </a>

    <div class="min-h-screen flex flex-col" id="contenido">
      <SiteHeader client:load />
      <slot />
      <SiteFooter />
      <WhatsappBar />
    </div>

    <Toaster client:load position="bottom-center" richColors closeButton />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(beautySalonSchema)} />
    {includeFaq && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {breadcrumbSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

    {site.plausibleDomain && (
      <script is:inline defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js" />
    )}

    <script is:inline>
      // Reveal en scroll · sin JS => contenido siempre visible · respeta reduced-motion
      (function () {
        if ("matchMedia" in window && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var HIDDEN = "data-reveal";
        function scan(root) {
          var els = (root || document).querySelectorAll(".reveal");
          Array.prototype.forEach.call(els, function (el) {
            if (!el.hasAttribute(HIDDEN)) {
              el.setAttribute(HIDDEN, "hidden");
              observer.observe(el);
            } else {
              observer.observe(el);
            }
          });
        }
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.removeAttribute(HIDDEN);
                observer.unobserve(en.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        scan(document);
        var mo = new MutationObserver(function (muts) {
          muts.forEach(function (m) {
            Array.prototype.forEach.call(m.addedNodes, function (n) {
              if (n.nodeType === 1) scan(n);
            });
          });
        });
        mo.observe(document.documentElement, { childList: true, subtree: true });
      })();
    </script>

    <WhatsappFloating />
  </body>
</html>