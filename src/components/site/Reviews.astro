---
const reviews = [
  {
    name: "[NOMBRE CLIENTA]",
    text: "«Aquí aparecerá la opinión real de una clienta tras su tratamiento.»",
    technique: "Microblading",
  },
  {
    name: "[NOMBRE CLIENTA]",
    text: "«Aquí aparecerá la opinión real de una clienta tras su tratamiento.»",
    technique: "Mixta",
  },
  {
    name: "[NOMBRE CLIENTA]",
    text: "«Aquí aparecerá la opinión real de una clienta tras su tratamiento.»",
    technique: "Microshading",
  },
];
---

<section id="opiniones" class="border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="reveal max-w-2xl">
      <p class="section-kicker">Opiniones</p>
      <h2 class="section-title mt-4">La experiencia de nuestras clientas</h2>
      <p class="mt-5 text-[0.95rem] leading-relaxed text-muted-foreground">
        Estamos incorporando reseñas reales verificadas. No publicamos opiniones inventadas.
      </p>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {reviews.map((r) => (
        <blockquote class="reveal flex flex-col border border-dashed border-border bg-card p-7">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-primary/50" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="mt-5 flex-1 font-display text-xl leading-snug text-muted-foreground">{r.text}</p>
          <footer class="mt-6 flex items-center justify-between">
            <span class="text-[0.72rem] uppercase tracking-[0.16em] text-muted-foreground">{r.name}</span>
            <span class="text-[0.62rem] uppercase tracking-[0.16em] text-primary">{r.technique}</span>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>