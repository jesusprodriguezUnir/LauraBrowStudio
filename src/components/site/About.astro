---
import { Image } from "astro:assets";
import portrait from "../../assets/portrait-professional.jpg";
import { site, waMessages } from "../../lib/site-config";
import WhatsappCta from "./WhatsappCta.astro";

const details = [
  ["Formación", "Técnico Superior en Estética Integral"],
  ["Certificaciones", "Máster en Microblading y Micropigmentación Avanzada"],
  ["Estudio", site.address],
  ["Zona de trabajo", `${site.city}, ${site.region}`],
];
---

<section id="sobre-mi" class="border-t border-border py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-[1fr_1.1fr] md:gap-16 md:px-8">
    <div class="reveal">
      <div class="image-frame aspect-[4/5]">
        <Image
          src={portrait}
          alt={`${site.name}, especialista en diseño de cejas y micropigmentación en ${site.city}`}
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 40vw, 92vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <div class="reveal">
      <p class="section-kicker">Sobre la profesional</p>
      <h2 class="section-title mt-4">Detrás de cada ceja hay una persona.</h2>
      <p class="mt-6 max-w-lg text-[0.95rem] leading-relaxed text-muted-foreground">
        «Soy {site.name}, especialista en diseño de cejas y micropigmentación. Mi objetivo es ayudarte a conseguir
        unas cejas que encajen contigo y conserven un aspecto natural.»
      </p>
      <dl class="mt-9 grid gap-px overflow-hidden rounded-sm bg-border sm:grid-cols-2">
        {details.map(([k, v]) => (
          <div class="bg-background p-5">
            <dt class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">{k}</dt>
            <dd class="mt-1.5 text-[0.85rem] leading-snug">{v}</dd>
          </div>
        ))}
      </dl>
      <WhatsappCta message={waMessages.general} class="mt-9" />
    </div>
  </div>
</section>