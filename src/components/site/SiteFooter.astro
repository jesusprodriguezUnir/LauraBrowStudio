---
import logoFull from "../../../logo.png";
import { site, instagramUrl, waLink, waMessages } from "../../lib/site-config";

const year = new Date().getFullYear();
const legal = [
  { label: "Aviso legal", href: "/aviso-legal" },
  { label: "Política de privacidad", href: "/politica-de-privacidad" },
  { label: "Política de cookies", href: "/politica-de-cookies" },
];

const waHref = waLink(waMessages.general);

/** Un dato por fila, cada uno accionable. El teléfono aparecía dos veces
 *  (como «WhatsApp» y como «Teléfono») con el mismo valor. */
const contact: { label: string; value: string; href?: string; external?: boolean }[] = [
  { label: "Teléfono", value: site.phoneDisplay, href: `tel:+${site.whatsappNumber}` },
  { label: "WhatsApp", value: "Escribir por WhatsApp", href: waHref, external: waHref.startsWith("http") },
  { label: "Email", value: site.email, href: `mailto:${site.email}` },
  { label: "Dirección", value: site.address },
  ...(instagramUrl !== "#"
    ? [{ label: "Instagram", value: `@${site.instagram}`, href: instagramUrl, external: true }]
    : []),
];
---

<footer class="border-t border-border bg-surface-muted py-14 pb-28 text-foreground md:pb-14">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-[1.2fr_1fr_1fr] md:px-8">
    <div>
      <img src={logoFull.src} alt={site.name} width={480} height={480} loading="lazy" class="h-24 w-auto max-w-[18rem] object-contain" />
      <p class="mt-4 max-w-xs text-[0.875rem] leading-relaxed text-muted-foreground">{site.claim}</p>
    </div>
    <div>
      <p class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-muted-foreground">Contacto</p>
      <ul class="mt-3 space-y-1.5 text-[0.9375rem]">
        {contact.map(({ label, value, href, external }) => (
          <li class="text-muted-foreground">
            <span class="text-muted-foreground/80">{label}:</span>{" "}
            {href ? (
              <a
                href={href}
                {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                class="text-foreground transition-colors duration-300 hover:text-muted-foreground"
              >
                {value}
              </a>
            ) : (
              <span class="text-foreground">{value}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.6875rem] uppercase tracking-[0.18em] text-muted-foreground">Legal</p>
      <ul class="mt-3 space-y-1.5 text-[0.9375rem]">
        {legal.map((l) => (
          <li>
            <a href={l.href} class="text-muted-foreground transition-colors duration-300 hover:text-foreground">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="mx-auto mt-12 max-w-6xl px-5 md:px-8">
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-border pt-6 font-mono text-[0.6875rem] uppercase tracking-[0.16em] text-muted-foreground">
      <p>{site.city} · {site.country} · {year}</p>
      <p>Microblading · Palencia</p>
      <p class="text-muted-foreground/70">
        Web diseñada por <a href="https://webdespega.com" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 transition-colors duration-300 hover:text-foreground">webdespega.com</a>
      </p>
    </div>
  </div>
</footer>