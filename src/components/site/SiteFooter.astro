---
import logoIvory from "../../assets/logo-wordmark-ivory.png";
import { site, instagramUrl } from "../../lib/site-config";

const year = new Date().getFullYear();
const legal = [
  { label: "Aviso legal", href: "/aviso-legal" },
  { label: "Política de privacidad", href: "/politica-de-privacidad" },
  { label: "Política de cookies", href: "/politica-de-cookies" },
];

const contact = [
  ["WhatsApp", site.phoneDisplay],
  ["Teléfono", site.phoneDisplay],
  ["Email", site.email],
  ["Dirección", site.address],
  ["Instagram", site.instagram],
];
---

<footer class="border-t border-border bg-surface-inverse py-14 pb-28 text-background md:pb-14">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 md:grid-cols-[1.2fr_1fr_1fr] md:px-8">
    <div>
      <img src={logoIvory.src} alt={site.name} width={480} height={180} loading="lazy" class="h-12 max-w-[12rem] object-contain" />
      <p class="mt-4 max-w-xs text-[0.82rem] leading-relaxed text-background/70">{site.claim}</p>
    </div>
    <div>
      <p class="text-[0.6rem] uppercase tracking-[0.18em] text-background/50">Contacto</p>
      <ul class="mt-3 space-y-1.5 text-[0.84rem] text-background/80">
        {contact.map(([k, v]) => (
          <li>
            <span class="text-background/50">{k}:</span> {v}
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-[0.6rem] uppercase tracking-[0.18em] text-background/50">Legal</p>
      <ul class="mt-3 space-y-1.5 text-[0.84rem]">
        {legal.map((l) => (
          <li>
            <a href={l.href} class="text-background/80 transition-colors hover:text-background">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="mx-auto mt-12 flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 md:px-8">
    <p class="border-t border-background/15 pt-6 text-[0.7rem] uppercase tracking-[0.16em] text-background/50">
      {site.city} · {site.country}
    </p>
    <p class="border-t border-background/15 pt-6 text-[0.7rem] uppercase tracking-[0.16em] text-background/50">
      Cejas · Micropigmentación · {year}
    </p>
  </div>
  {instagramUrl !== "#" && (
    <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="sr-only">
      Perfil de Instagram de {site.name}
    </a>
  )}
</footer>