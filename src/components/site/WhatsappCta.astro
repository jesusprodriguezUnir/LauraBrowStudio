---
import { waLink } from "../../lib/site-config";

interface Props {
  message: string;
  /** Texto del botón */
  children?: string;
  variant?: "solid" | "outline";
  class?: string;
  size?: "default" | "sm" | "lg";
}

const { message, children = "Reservar valoración", variant = "solid", class: className = "", size = "default" } = Astro.props;
const href = waLink(message);
const external = href.startsWith("http");
const externalAttr = external ? { target: "_blank", rel: "noopener noreferrer" } : {};
const sizes: Record<string, string> = {
  sm: "px-4 py-2.5 text-[0.72rem]",
  default: "px-6 py-3 text-[0.78rem]",
  lg: "px-9 py-4 text-[0.78rem]",
};
---

<a
  href={href}
  {...externalAttr}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-full transition-all duration-300",
    sizes[size],
    variant === "solid"
      ? "bg-foreground text-background hover:bg-primary"
      : "border border-border text-foreground hover:border-foreground",
    className,
  ]}
>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
  </svg>
  <span>{children}</span>
</a>