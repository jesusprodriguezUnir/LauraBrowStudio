---
import { Image } from "astro:assets";
import brow from "../../assets/brow-result.jpg";
import { waMessages } from "../../lib/site-config";
import WhatsappCta from "./WhatsappCta.astro";

const facts = [
  ["Duración de la sesión", "Entre 2 h y 2 h 30, incluyendo valoración, diseño y pigmentación."],
  ["Sesiones", "Primera sesión + retoque de perfeccionamiento a las 4-8 semanas."],
  ["Duración del resultado", "De 12 a 18 meses de media, según piel, cuidados y sol."],
  ["Molestias", "Molesto pero tolerable. Se aplica anestésico tópico durante el procedimiento."],
  ["Recuperación", "Vida normal desde el primer día. Descamación leve entre el día 5 y 10."],
  ["Material", "Uso individual y desechable, pigmentos certificados y protocolo higiénico-sanitario."],
];

const goodFor = [
  "Cejas finas, con poco vello o asimétricas",
  "Zonas despobladas por depilación o cicatrices",
  "Ganas de dejar de rellenar la ceja cada mañana",
  "Piel normal o seca; en piel grasa el trazo dura menos, se valora en la cita",
];

const notFor = [
  "Embarazo o lactancia",
  "Diabetes descompensada, problemas de coagulación o anticoagulantes",
  "Tratamiento oncológico activo, isotretinoína reciente o cicatrización queloide",
  "Piel de la zona irritada, con dermatitis, herida o brote de acné",
];
---

<section id="microblading" class="border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid gap-12 md:grid-cols-[1.05fr_0.95fr] md:gap-16">
      <div class="reveal">
        <p class="section-kicker">Qué es</p>
        <h2 class="section-title mt-4">Microblading pelo a pelo</h2>
        <p class="mt-6 text-[0.95rem] leading-relaxed text-muted-foreground">
          Es una técnica manual. Con una herramienta de microcuchillas deposito pigmento
          en la capa más superficial de la piel, trazo a trazo, imitando el pelo. El
          resultado es una ceja con más forma y densidad que sigue pareciendo tuya.
        </p>
        <p class="mt-4 text-[0.95rem] leading-relaxed text-muted-foreground">
          No es un tatuaje: el pigmento no llega a la dermis profunda. Por eso dura, pero
          no para siempre, y se va aclarando. Antes de pigmentar dibujo el diseño a mano
          y eliges el tono conmigo, según tu piel, tu vello y tu cabello.
        </p>
        <div class="mt-8">
          <WhatsappCta message={waMessages.general}>Pedir valoración</WhatsappCta>
        </div>
      </div>

      <div class="reveal">
        <div class="image-frame aspect-[4/5]">
          <Image
            src={brow}
            alt="Detalle de microblading pelo a pelo. Fotografía provisional, a sustituir por un trabajo del estudio."
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 42vw, 92vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-sm bg-border sm:grid-cols-2 lg:grid-cols-3">
      {facts.map(([title, text]) => (
        <li class="reveal bg-background p-6">
          <h3 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-primary">{title}</h3>
          <p class="mt-3 text-[0.88rem] leading-relaxed text-muted-foreground">{text}</p>
        </li>
      ))}
    </ul>

    <div class="mt-12 grid gap-8 md:grid-cols-2">
      <div class="reveal bg-secondary/50 p-7">
        <h3 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em]">
          Puede encajar si…
        </h3>
        <ul class="mt-5 space-y-3">
          {goodFor.map((item) => (
            <li class="border-l border-primary/50 pl-3 text-[0.88rem] leading-relaxed text-muted-foreground">
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal bg-secondary/50 p-7">
        <h3 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em]">
          No se puede hacer si…
        </h3>
        <ul class="mt-5 space-y-3">
          {notFor.map((item) => (
            <li class="border-l border-border pl-3 text-[0.88rem] leading-relaxed text-muted-foreground">
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[0.78rem] leading-relaxed text-muted-foreground">
          Si hay duda médica, pido informe o autorización antes de la sesión.
        </p>
      </div>
    </div>
  </div>
</section>
