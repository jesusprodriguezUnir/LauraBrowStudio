---
import { Image } from "astro:assets";
import browHero from "../../assets/brow-hero.jpg";
import { site, waMessages } from "../../lib/site-config";
import WhatsappCta from "./WhatsappCta.astro";
---

<section id="inicio" class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-[1.05fr_0.95fr] md:px-8">
    <div class="reveal max-w-3xl">
      <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span> Estudio en {site.city}</p>
      <h1 class="display-xl mt-5 text-foreground">
        Microblading de cejas con <strong>resultados naturales</strong>
      </h1>
      <p class="mt-6 max-w-xl text-[0.95rem] leading-relaxed text-muted-foreground">
        Estudio <strong class="font-semibold text-foreground">especializado exclusivamente en cejas</strong> en {site.city}.
        Diseño personalizado según tus facciones, con una técnica precisa que respeta tu piel.
      </p>
      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-start">
        <WhatsappCta message={waMessages.general} size="lg" class="w-full sm:w-auto">
          Reservar cita
        </WhatsappCta>
        <a
          href="#resultados"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-border px-9 py-4 text-[0.78rem] uppercase tracking-[0.14em] text-foreground transition-colors duration-300 hover:bg-secondary sm:w-auto"
        >
          Ver resultados
        </a>
      </div>
      <dl class="mt-12 grid max-w-md grid-cols-3 gap-4 border-t border-border pt-8">
        <div>
          <dt class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">Técnica</dt>
          <dd class="mt-1 font-display text-xl tracking-tight">Pelo a pelo</dd>
        </div>
        <div>
          <dt class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">Resultado</dt>
          <dd class="mt-1 font-display text-xl tracking-tight">12-18 meses</dd>
        </div>
        <div>
          <dt class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">Cita previa</dt>
          <dd class="mt-1 font-display text-xl tracking-tight">WhatsApp</dd>
        </div>
      </dl>
    </div>

    <div class="reveal">
      <div class="image-frame aspect-[4/5]">
        <Image
          src={browHero}
          alt="Detalle de una ceja con diseño de microblading pelo a pelo realizado en Palencia"
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 40vw, 92vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>