---
import { Image } from "astro:assets";
import browHero from "../../assets/brow-hero.jpg";
import { site, waMessages } from "../../lib/site-config";
import WhatsappCta from "./WhatsappCta.astro";

const stats = [
  ["Técnica", "Pelo a pelo"],
  ["Duración", "12-18 meses"],
  ["Cita previa", "WhatsApp"],
];
---

<section id="inicio" class="relative overflow-hidden pt-32 pb-20 md:pt-40 md:pb-28">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,var(--surface-muted),transparent_60%)] opacity-70"></div>
  <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-12 px-5 md:grid-cols-[1.05fr_0.95fr] md:px-8">
    <div class="reveal max-w-3xl">
      <p class="section-kicker">Microblading · {site.city}</p>
      <h1 class="display-xl mt-4 text-foreground">
        Cejas que parecen <strong>tuyas</strong>
      </h1>
      <p class="mt-6 max-w-xl text-[0.95rem] leading-relaxed text-muted-foreground">
        Microblading pelo a pelo en {site.city}. Trabajo sola, con cita previa.
        Diseño la ceja sobre tu rostro y no pigmento hasta que la apruebas.
      </p>
      <div class="mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <WhatsappCta message={waMessages.general} size="lg">
          Pedir valoración
        </WhatsappCta>
        <a href="/resultados" class="btn btn-lg btn-ghost">Ver resultados</a>
      </div>
      <dl class="mt-12 grid max-w-md grid-cols-3 gap-4 border-t border-border pt-8">
        {stats.map(([label, value]) => (
          <div>
            <dt class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">{label}</dt>
            <dd class="mt-1 font-display text-xl tracking-tight">{value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="reveal">
      <div class="image-frame aspect-[4/5]">
        <Image
          src={browHero}
          alt="Detalle de una ceja con microblading pelo a pelo. Fotografía provisional, a sustituir por un trabajo del estudio."
          widths={[480, 720, 960]}
          sizes="(min-width: 768px) 40vw, 92vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
