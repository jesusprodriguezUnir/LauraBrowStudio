---
import { Image } from "astro:assets";
import studioDetail from "../../assets/studio-detail.jpg";

const factors = [
  ["Facciones", "Cómo cae la ceja respecto a ojos, nariz y frente."],
  ["Forma del rostro", "La línea tiene que acompañar tu cara, no una plantilla."],
  ["Cejas actuales", "Parto de lo que tienes, no de una ceja inventada."],
  ["Densidad del pelo", "Dónde hay vello que seguir y dónde hay que dibujar."],
  ["Tipo de piel", "En piel grasa el trazo se mantiene peor. Se valora en la cita."],
  ["Lo que buscas", "Natural no significa lo mismo para todas."],
];
---

<section id="filosofia" class="border-t border-border py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-[0.95fr_1.05fr] md:gap-16 md:px-8">
    <div class="reveal">
      <p class="section-kicker">Cómo decido</p>
      <h2 class="section-title mt-4">No todas las cejas encajan en el microblading.</h2>
      <p class="mt-6 max-w-md font-display text-xl italic leading-snug text-muted-foreground">
        «No busco una ceja de revista. Busco la que encaja con tu cara y con tu pelo.»
      </p>
      <div class="image-frame mt-9 aspect-[4/3]">
        <Image
          src={studioDetail}
          alt="Espacio de trabajo del estudio. Fotografía provisional, a sustituir por el estudio real."
          widths={[420, 640, 900]}
          sizes="(min-width: 768px) 40vw, 92vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <ul class="grid gap-px overflow-hidden rounded-sm bg-border sm:grid-cols-2">
      {factors.map(([title, text], i) => (
        <li class="reveal bg-background p-6">
          <span class="font-mono text-[0.62rem] tracking-[0.16em] text-primary">0{i + 1}</span>
          <h3 class="mt-3 font-display text-xl tracking-tight">{title}</h3>
          <p class="mt-2 text-[0.85rem] leading-relaxed text-muted-foreground">{text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
