---
import { Image } from "astro:assets";
import result1 from "../../assets/case-result-1.jpg";
import { waMessages } from "../../lib/site-config";
import WhatsappCta from "./WhatsappCta.astro";

const facts = [
  ["Sesión", "2 h – 2 h 30"],
  ["Efecto", "12 – 18 meses"],
  ["Plan", "Primera sesión + retoque"],
];
---

<section id="servicios" class="border-t border-border bg-secondary/40 py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="grid items-center gap-12 md:grid-cols-[1.05fr_0.95fr] md:gap-16">
      <div class="reveal">
        <p class="section-kicker">El tratamiento</p>
        <h2 class="section-title mt-4">Microblading pelo a pelo</h2>
        <p class="mt-6 text-[0.95rem] leading-relaxed text-muted-foreground">
          Con una herramienta de microcuchillas deposito pigmento en trazos finos, uno a uno,
          en la capa más superficial de la piel. El objetivo es densificar y dar forma
          siguiendo tu propio vello, no dibujar una ceja encima.
        </p>
        <p class="mt-4 text-[0.95rem] leading-relaxed text-muted-foreground">
          No es un tatuaje: el pigmento no llega a la dermis profunda. Dura de media de 12 a
          18 meses, según piel, cuidados y sol, y se va aclarando poco a poco.
        </p>
        <dl class="mt-8 grid grid-cols-3 gap-4 border-t border-border pt-6">
          {facts.map(([label, value]) => (
            <div>
              <dt class="text-[0.6rem] uppercase tracking-[0.18em] text-muted-foreground">{label}</dt>
              <dd class="mt-1.5 text-[0.88rem] leading-snug">{value}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
          <WhatsappCta message={waMessages.general}>Pedir valoración</WhatsappCta>
          <a href="/microblading" class="btn btn-ghost">Cómo es el tratamiento</a>
        </div>
      </div>

      <div class="reveal">
        <div class="image-frame aspect-[4/5]">
          <Image
            src={result1}
            alt="Resultado de microblading pelo a pelo. Fotografía provisional, a sustituir por un trabajo del estudio."
            widths={[420, 640, 840]}
            sizes="(min-width: 768px) 40vw, 92vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
