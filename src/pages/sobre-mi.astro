---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site-config";
import { SiteHeader } from "../components/site/site-header";
import PageHeader from "../components/site/PageHeader.astro";
import About from "../components/site/About.astro";
import Philosophy from "../components/site/Philosophy.astro";
import Values from "../components/site/Values.astro";
import LocalSeo from "../components/site/LocalSeo.astro";
import FinalCta from "../components/site/FinalCta.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import WhatsappBar from "../components/site/WhatsappBar.astro";

const title = `Sobre mí | ${site.name}`;
const description =
  "Laura, microblading de cejas en Palencia: cómo trabajo, qué miro en cada valoración y por qué solo hago esta técnica.";
---

<Layout title={title} description={description} path="/sobre-mi">
  <div class="min-h-screen" id="contenido">
    <SiteHeader client:load />
    <main>
      <PageHeader
        kicker="Sobre mí"
        title="Un estudio de una sola profesional"
        intro="Trabajo con cita previa y de una en una. La valoración, el diseño y la sesión los hago yo."
      />
      <About />
      <Philosophy />
      <Values />
      <LocalSeo />
      <FinalCta />
    </main>
    <SiteFooter />
    <WhatsappBar />
  </div>
</Layout>
