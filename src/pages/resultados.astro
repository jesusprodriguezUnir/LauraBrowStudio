---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site-config";
import { SiteHeader } from "../components/site/site-header";
import PageHeader from "../components/site/PageHeader.astro";
import { BeforeAfter } from "../components/site/before-after";
import HealedResults from "../components/site/HealedResults.astro";
import Reviews from "../components/site/Reviews.astro";
import FinalCta from "../components/site/FinalCta.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import WhatsappBar from "../components/site/WhatsappBar.astro";

const title = `Resultados de microblading | ${site.name}`;
const description =
  "Antes, después y resultado cicatrizado de microblading en Palencia. El día de la sesión el pigmento se ve más intenso; el resultado real llega semanas después.";
---

<Layout title={title} description={description} path="/resultados">
  <div class="min-h-screen" id="contenido">
    <SiteHeader client:load />
    <main>
      <PageHeader
        kicker="Resultados"
        title="Antes, después y, sobre todo, cicatrizado"
        intro="El día de la sesión el pigmento se ve más intenso. El resultado real aparece cuando la piel ha cicatrizado. Las fotos de esta página son provisionales hasta que Laura envíe las suyas."
      />
      <BeforeAfter client:visible />
      <HealedResults />
      <Reviews />
      <FinalCta />
    </main>
    <SiteFooter />
    <WhatsappBar />
  </div>
</Layout>
