---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site-config";
import { SiteHeader } from "../components/site/site-header";
import PageHeader from "../components/site/PageHeader.astro";
import MicrobladingInfo from "../components/site/MicrobladingInfo.astro";
import { TechniqueQuiz } from "../components/site/technique-quiz";
import Process from "../components/site/Process.astro";
import Aftercare from "../components/site/Aftercare.astro";
import FaqSection from "../components/site/FaqSection.astro";
import FinalCta from "../components/site/FinalCta.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import WhatsappBar from "../components/site/WhatsappBar.astro";

const title = `Microblading en ${site.city}: qué es, proceso y cuidados | ${site.name}`;
const description =
  "Qué es el microblading pelo a pelo, para quién encaja, cómo es la sesión en Palencia y qué cuidados necesita después.";
---

<Layout title={title} description={description} path="/microblading" includeFaq>
  <div class="min-h-screen" id="contenido">
    <SiteHeader client:load />
    <main>
      <PageHeader
        kicker="Microblading en Palencia"
        title="La técnica, sin rodeos"
        intro="Qué es, para quién encaja, cómo es la sesión y qué ocurre después. Si no es para ti, también te lo digo."
      />
      <MicrobladingInfo />
      <TechniqueQuiz client:visible />
      <Process />
      <Aftercare />
      <FaqSection />
      <FinalCta />
    </main>
    <SiteFooter />
    <WhatsappBar />
  </div>
</Layout>
