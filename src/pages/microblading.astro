---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site-config";
import { SiteHeader } from "../components/site/site-header";
import PageHeader from "../components/site/PageHeader.astro";
import MicrobladingInfo from "../components/site/MicrobladingInfo.astro";
import { TechniqueQuiz } from "../components/site/technique-quiz";
import Process from "../components/site/Process.astro";
import Aftercare from "../components/site/Aftercare.astro";
import FinalCta from "../components/site/FinalCta.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import WhatsappBar from "../components/site/WhatsappBar.astro";

const title = `Microblading en ${site.city}: técnicas y proceso | ${site.name}`;
const description =
  "Qué es el microblading, en qué se diferencia del microshading y de la técnica mixta, cómo es el proceso paso a paso y qué cuidados necesita después.";
---

<Layout title={title} description={description} path="/microblading">
  <div class="min-h-screen" id="contenido">
    <SiteHeader client:load />
    <main>
      <PageHeader
        kicker="Microblading"
        title="La técnica, paso a paso"
        intro="Qué es exactamente, para quién encaja, cómo es la sesión y qué cuidados necesita después. Sin promesas de más."
      />
      <MicrobladingInfo />
      <TechniqueQuiz client:visible />
      <Process />
      <Aftercare />
      <FinalCta />
    </main>
    <SiteFooter />
    <WhatsappBar />
  </div>
</Layout>
