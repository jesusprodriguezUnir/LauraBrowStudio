---
import Layout from '../layouts/Layout.astro';
import { site } from '../lib/site-config';
import { SiteHeader } from '../components/site/site-header';
import { Hero } from '../components/site/hero';
import { MicrobladingInfo } from '../components/site/microblading-info';
import { BeforeAfter } from '../components/site/before-after';
import { Services } from '../components/site/services';
import { Aftercare } from '../components/site/aftercare';
import { About } from '../components/site/about';
import { FaqSection } from '../components/site/faq-section';
import { Reviews } from '../components/site/reviews';
import { FinalCta } from '../components/site/final-cta';
import { SiteFooter } from '../components/site/site-footer';
import { WhatsappBar } from '../components/site/whatsapp-bar';

const title = `Microblading en Palencia | ${site.name}`;
const description = "Microblading pelo a pelo en Palencia. Resultado natural, diseñado según tus facciones. Especialistas en micropigmentación de cejas. Solicita tu valoración.";
---

<Layout title={title} description={description}>
    <div class="min-h-screen">
      <SiteHeader client:load />
      <main>
        <Hero client:load />
        <MicrobladingInfo client:load />
        <BeforeAfter client:load />
        <Services client:load />
        <Aftercare client:load />
        <About client:load />
        <FaqSection client:load />
        <Reviews client:load />
        <FinalCta client:load />
      </main>
      <SiteFooter client:load />
      <WhatsappBar client:load />
    </div>
</Layout>
